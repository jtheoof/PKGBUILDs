#!/bin/sh
# Example pre-backup hook: consistent copies of SQLite databases.
#
# Install as /etc/restic/hooks/pre-backup.d/10-sqlite (mode 755, owned by root).
# Edit the list of databases below. Copies go to $RESTIC_STAGING_DIR/<original path>,
# which is part of the backup when RESTIC_BACKUP_PATHS includes / (the default).
#
# -readonly: the database itself is never modified. If it is in WAL mode and idle,
# SQLite still creates -wal and -shm files next to it, owned by the database's owner
# when this runs as root. See restic-backup-hooks(7).
set -eu

for db in /var/lib/myapp/*.db; do
  [ -f "$db" ] || continue
  dest=$RESTIC_STAGING_DIR$db
  mkdir -p "$(dirname "$dest")"
  sqlite3 -readonly "$db" ".backup '$dest'"
done
