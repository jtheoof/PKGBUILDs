# Maintainer: Jeremy Attali <contact@jtheoof.me>

pkgname=restic-backup
pkgver=1.0.0
pkgrel=2
pkgdesc='Scheduled restic backups with hooks, a mount guard, status files and systemd timers'
arch=(any)
url='https://github.com/jtheoof/PKGBUILDs'
license=('MIT')
depends=(bash coreutils openssl restic sed util-linux)
makedepends=(scdoc)
optdepends=('sqlite: SQLite example hook'
            'postgresql: PostgreSQL example hook')
backup=(etc/restic/env
        etc/restic/excludes)
install=$pkgname.install
source=(LICENSE
        README.md
        restic-backup
        restic-backup.8.scd
        restic-backup.conf.5.scd
        restic-backup-hooks.7.scd
        env
        excludes
        restic-backup.tmpfiles
        restic-backup.service
        restic-backup.timer
        restic-backup-prune.service
        restic-backup-prune.timer
        restic-backup-check.service
        restic-backup-check.timer
        example-sqlite
        example-postgresql
        example-stop-service
        example-start-service
        example-recovery)
sha256sums=('376f25097ddcaa268a51c4de12cc7c53ff8c11aeba9652e8d78b32bffc0b802f'
            'b8f82612d5dd9c9d7007dc7556b2a23aa2517f15da6c4d8cb5bdb8022eb4d80e'
