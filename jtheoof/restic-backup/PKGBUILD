build() {
  scdoc < restic-backup.8.scd > restic-backup.8
  scdoc < restic-backup.conf.5.scd > restic-backup.conf.5
  scdoc < restic-backup-hooks.7.scd > restic-backup-hooks.7
}

package() {
  install -Dm755 restic-backup "$pkgdir/usr/bin/restic-backup"
  sed -i "s/@VERSION@/$pkgver/" "$pkgdir/usr/bin/restic-backup"

  install -Dm644 restic-backup{,-prune,-check}.{service,timer} \
    -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 restic-backup.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/restic-backup.conf"

  # root only. The repository password (/etc/restic/password) is deliberately NOT
  # packaged: the install script creates it only if it is missing.
  install -dm700 "$pkgdir/etc/restic"
  install -m600 env excludes "$pkgdir/etc/restic/"
  local event job
  for event in pre post; do
    for job in backup prune check; do
      install -dm755 "$pkgdir/etc/restic/hooks/$event-$job.d"
    done
  done

  install -Dm644 restic-backup.8 -t "$pkgdir/usr/share/man/man8/"
  install -Dm644 restic-backup.conf.5 -t "$pkgdir/usr/share/man/man5/"
  install -Dm644 restic-backup-hooks.7 -t "$pkgdir/usr/share/man/man7/"

  local doc="$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 README.md -t "$doc/"
  # not executable on purpose: they do nothing until copied into a hook directory
  install -Dm644 example-sqlite "$doc/examples/hooks/pre-backup.d/10-sqlite"
  install -Dm644 example-postgresql "$doc/examples/hooks/pre-backup.d/10-postgresql"
  install -Dm644 example-stop-service "$doc/examples/hooks/pre-backup.d/10-stop-myapp"
  install -Dm644 example-start-service "$doc/examples/hooks/post-backup.d/90-start-myapp"
  install -Dm755 example-recovery "$doc/examples/recovery/restore.sh"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
