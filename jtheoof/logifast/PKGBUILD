# Maintainer: Jeremy Attali <contact@jtheoof.me>
#
# logifast built from git. For now the source is the local checkout
# (commits only; uncommitted changes are not picked up); switch _repo to
# the GitHub URL once it is published.
#
#   makepkg -si
#   systemctl --user enable --now logifast.service
#
# Build another branch or checkout:
#   _branch=some-branch makepkg -si
#   _repo=~/src/logifast makepkg -si

pkgname=logifast
pkgver=0.1.0.r57.g6122130
pkgrel=1
pkgdesc='Configure Logitech G devices (lighting, per-key RGB, DPI, report rate) over HID++, a Linux take on G HUB'
arch=('x86_64')
url='https://github.com/jtheoof/logifast'
license=('MIT OR Apache-2.0')
# logifast-gui draws with OpenGL (glow) on Wayland or X11; both are
# loaded at runtime, so they are not linked dependencies.
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd' 'libxkbcommon')
optdepends=('wayland: logifast-gui on Wayland'
            'libx11: logifast-gui on X11')
makedepends=('cargo' 'git')
install=logifast.install

: "${_repo:=${HOME}/dev/github.com/jtheoof/logifast}"
: "${_branch:=master}"
source=("$pkgname::git+${_repo/#\//file:///}#branch=$_branch")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # No release tags yet: Cargo version, commit count, short hash.
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Unit tests only; nothing here talks to a device.
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/logifast "$pkgdir/usr/bin/logifast"
  install -Dm755 target/release/logifast-gui "$pkgdir/usr/bin/logifast-gui"
  install -Dm644 packaging/logifast.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/logifast.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/logifast.svg"
  install -Dm644 packaging/logifast.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 packaging/70-logifast.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 examples/config.toml "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
