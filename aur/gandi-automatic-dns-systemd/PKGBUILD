
# Maintainer: Jeremy Attali <contact@jtheoof.me>

pkgname=gandi-automatic-dns-systemd
_pkgname=${pkgname%-systemd}
pkgver=1.0.0
pkgrel=1
pkgdesc="systemd files to automate DNS updates for gandi-automate-dns package"
arch=('any')
url="https://github.com/brianreumere/gandi-automatic-dns/"
source=(
  'gandi-automatic-dns.service'
  'gandi-automatic-dns.sysusers'
  'gandi-automatic-dns.timer'
  'gandi-automatic-dns.tmpfiles'
)
sha256sums=(
  '3d8c2801f6a679d03d1aebcb357fd2a4dea8704d7042ff5a8e44f574761c7a4f'
  '60b844d82673e3a8d351533446adb0f3b60f27159c222f32b6fe1aca8a385f67'
  '2d205965806831ebf4bad7ece8cb87635e7ce86cdcca9b2dfd8244c0919de253'
  '05b168ff19c3c70c713f4768a5dc13851ed410b4884992a2b7ba16473c576466'
)

package() {
  install -Dm644 "${_pkgname}.timer" "${pkgdir}/usr/lib/systemd/system/${_pkgname}.timer"
  install -Dm644 "${_pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"
  install -Dm644 "${_pkgname}.sysusers" "${pkgdir}/usr/lib/sysusers.d/${_pkgname}.conf"
  install -Dm644 "${_pkgname}.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/${_pkgname}.conf"
}
